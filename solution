    "        self.b = b\n",
    "        self.doc_tokens = [tokenize(c[\"content\"] + \" \" + c[\"section_name\"]) for c in chunks]\n",
    "        self.doc_lens = [len(tokens) for tokens in self.doc_tokens]\n",
    "        self.avgdl = sum(self.doc_lens) / max(1, len(chunks))\n",
    "        \n",
    "        self.df = Counter()\n",
    "        self.doc_tfs = []\n",
    "        for tokens in self.doc_tokens:\n",
    "            tf = Counter(tokens)\n",
    "            self.doc_tfs.append(tf)\n",
    "            for word in tf.keys():\n",
    "                self.df[word] += 1\n",
    "                \n",
    "        self.idf = {}\n",
    "        N = len(chunks)\n",
    "        for word, freq in self.df.items():\n",
    "            self.idf[word] = math.log((N - freq + 0.5) / (freq + 0.5) + 1.0)\n",
    "            \n",
    "    def score_doc(self, doc_idx, query_tokens):\n",
    "        tf = self.doc_tfs[doc_idx]\n",
    "        doc_len = self.doc_lens[doc_idx]\n",
    "        len_norm = 1.0 - self.b + self.b * (doc_len / self.avgdl)\n",
    "        score = 0.0\n",
    "        for token in query_tokens:\n",
    "            if token in tf:\n",
    "                f = tf[token]\n",
    "                score += self.idf.get(token, 0.0) * ((f * (self.k1 + 1.0)) / (f + self.k1 * len_norm))\n",
    "        return score\n",
    "\n",
    "BM25_INDEX = BM25Retriever(all_report_chunks)\n",
    "CHUNK_ID_MAP = {id(c): i for i, c in enumerate(all_report_chunks)}\n",
    "\n",
    "\n",
    "# Universal Targeted Context Retriever\n",
    "\n",
    "def retrieve_targeted_context(question_text, chunks):\n",
    "    \"\"\"\n",
    "    Universal Context Retriever:\n",
    "    1. Extracts well entity and dates dynamically from the question.\n",
    "    2. Filters chunk candidate pool by metadata.\n",
    "    3. Uses Okapi BM25 for mathematical relevance scoring.\n",
    "    4. Returns balanced, diversified sections covering all requested entities.\n",
    "    \"\"\"\n",
    "    wells = [wk for wk, pattern in WELL_PATTERNS if pattern.search(question_text)]\n",
    "    exact_dates = re.findall(r\"\\b\\d{4}-\\d{2}-\\d{2}\\b\", question_text)\n",
    "    years       = re.findall(r\"\\b(19\\d{2}|20\\d{2})\\b\", question_text)\n",
    "    \n",
    "    candidates = []\n",
    "    for c in chunks:\n",
    "        if wells and get_well_key(c) not in wells:\n",
    "            continue\n",
    "        if exact_dates:\n",
    "            if c[\"report_date\"] not in exact_dates:\n",
    "                continue\n",
    "        elif years:\n",
    "            if not any(c[\"report_date\"].startswith(y) for y in years):\n",
    "                continue\n",
    "        candidates.append(c)\n",
    "        \n",
    "    if not candidates:\n",
    "        return []\n",
    "\n",
    "    q_tokens = tokenize(question_text)\n",
    "    scored = []\n",
    "    for c in candidates:\n",
    "        idx = CHUNK_ID_MAP[id(c)]\n",
    "        score = BM25_INDEX.score_doc(idx, q_tokens)\n",
    "        scored.append((c, score))\n",
    "        \n",
    "    scored.sort(key=lambda x: x[1], reverse=True)\n",
    "    \n",
    "    # Case A: Single well, single date -> top 2 sections\n",
    "    if len(exact_dates) == 1 and len(wells) <= 1:\n",
    "        top_chunks = [c for c, s in scored[:2] if s > 0]\n",
    "        return top_chunks if top_chunks else [scored[0][0]]\n",
    "        \n",
    "    # Case B: Multi-well query -> top chunk(s) per mentioned well (entity diversification)\n",
    "    if len(wells) > 1:\n",
    "        selected = []\n",
    "        for w in wells:\n",
    "            well_scored = [(c, s) for c, s in scored if get_well_key(c) == w and s > 0]\n",
    "            if well_scored:\n",
    "                selected.append(well_scored[0][0])\n",
    "                if len(well_scored) > 1 and well_scored[1][1] > well_scored[0][1] * 0.6:\n",
    "                    selected.append(well_scored[1][0])\n",
