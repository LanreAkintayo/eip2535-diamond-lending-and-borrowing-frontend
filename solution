    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "def locate_dataset_folder():\n",
    "    \"\"\"\n",
    "    Finds the Track 2 data directory whether running from the repository\n",
    "    root or from inside the submission folder.\n",
    "    \"\"\"\n",
    "    possible_locations = [\n",
    "        Path.cwd() / \"data\" / \"track_2\",\n",
    "        Path.cwd().parent / \"data\" / \"track_2\",\n",
    "        Path(\"data/track_2\"),\n",
    "        Path(\"../data/track_2\")\n",
    "    ]\n",
    "    for folder in possible_locations:\n",
    "        if folder.is_dir():\n",
    "            return folder.resolve()\n",
    "    raise FileNotFoundError(\"Could not locate 'data/track_2'. Please check dataset path.\")\n",
