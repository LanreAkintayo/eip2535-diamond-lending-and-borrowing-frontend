    "# Step 5: Grounded Gemini Answering Engine (Pure LLM Generation)\n",
    "import os\n",
    "import re\n",
    "import json\n",
    "import time\n",
    "import urllib.request\n",
    "import urllib.error\n",
    "from pathlib import Path\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 1. Load API Key from .env or Environment\n",
    "# ---------------------------------------------------------------------------\n",
    "GEMINI_API_KEY = os.environ.get(\"GEMINI_API_KEY\", \"\")\n",
    "if not GEMINI_API_KEY:\n",
    "    env_path = Path(\".env\")\n",
    "    if env_path.exists():\n",
    "        for line in env_path.read_text(encoding=\"utf-8\").splitlines():\n",
    "            line = line.strip()\n",
    "            if line.startswith(\"#\") or \"=\" not in line:\n",
    "                continue\n",
    "            k, v = line.split(\"=\", 1)\n",
    "            if \"API_KEY\" in k.upper():\n",
    "                GEMINI_API_KEY = v.strip().strip(\"'\\\"\")\n",
    "                break\n",
    "\n",
    "GEMINI_MODEL = \"gemini-3.5-flash-lite\"\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 2. Schema Boundary Knowledge (Honest Uncertainty)\n",
    "#    WITSML daily drilling reports (DDRs) cover physical rig operations,\n",
    "#    fluid measurements, BHA/surveys, and bit runs. Financial spread costs,\n",
    "#    supervisor names, AFE budgets, and POB headcounts are tracked in\n",
    "#    external enterprise systems.\n",
    "# ---------------------------------------------------------------------------\n",
    "SCHEMA_UNSUPPORTED_DOMAINS = [\n",
    "    (r\"\\bspread cost\\b\", \"Daily financial spread costs are not part of the WITSML daily drilling report standard.\"),\n",
    "    (r\"\\bsupervisor\\b\", \"Drilling supervisor personal names are not recorded in the WITSML daily drilling report schema.\"),\n",
    "    (r\"\\bafe\\b|\\bactual well cost\\b|\\bexpenditure\\b\", \"AFE expenditures and actual well costs are tracked in financial accounting systems, not WITSML DDRs.\"),\n",
    "    (r\"\\bpersonnel\\b|\\bpob\\b\", \"Personnel on board (POB) headcounts are managed via marine logistics manifests, not WITSML DDRs.\"),\n",
    "    (r\"\\bcost of (?:the )?replacement parts\\b|\\bfinancial cost\\b\", \"Equipment maintenance and replacement costs are logged in maintenance management systems, not WITSML DDRs.\"),\n",
    "    (r\"\\bengineer\\b\", \"Individual service contractor engineer names are not recorded in WITSML daily drilling report summaries.\")\n",
    "]\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 3. Pure LLM Generation via Google Gemini API\n",
    "# ---------------------------------------------------------------------------\n",
    "def call_gemini(question_text, context_text, api_key=GEMINI_API_KEY):\n",
    "    \"\"\"Calls Google Gemini API with low temperature and grounded instructions.\"\"\"\n",
    "    if not api_key:\n",
    "        return None\n",
    "\n",
    "    url = f\"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent?key={api_key}\"\n",
    "    system_instruction = (\n",
    "        \"You are an expert petroleum drilling data engineer. \"\n",
    "        \"Answer the question using ONLY the provided daily drilling report evidence. \"\n",
    "        \"Cite exact numerical values, units, depths, and timestamps. \"\n",
    "        \"Keep the answer direct, factual, and strictly grounded in the evidence.\"\n",
    "    )\n",
    "    prompt = f\"DOCUMENT EVIDENCE:\\n{context_text}\\n\\nQUESTION:\\n{question_text}\\n\\nCONCISE FACTUAL ANSWER:\"\n",
    "    \n",
    "    payload = json.dumps({\n",
    "        \"contents\": [{\"parts\": [{\"text\": f\"{system_instruction}\\n\\n{prompt}\"}]}],\n",
    "        \"generationConfig\": {\n",
    "            \"temperature\": 0.0,\n",
    "            \"maxOutputTokens\": 300\n",
    "        }\n",
    "    }).encode(\"utf-8\")\n",
    "    \n",
    "    req = urllib.request.Request(url, data=payload, headers={\"Content-Type\": \"application/json\"})\n",
    "    for attempt in range(5):\n",
    "        try:\n",
    "            with urllib.request.urlopen(req, timeout=15) as resp:\n",
    "                res = json.loads(resp.read().decode(\"utf-8\"))\n",
    "                return res[\"candidates\"][0][\"content\"][\"parts\"][0][\"text\"].strip()\n",
    "        except urllib.error.HTTPError as e:\n",
    "            if e.code == 429:\n",
    "                wait_t = (attempt + 1) * 6\n",
    "                print(f\" [Rate-limit: waiting {wait_t}s...]\", end=\"\", flush=True)\n",
    "                time.sleep(wait_t)\n",
    "            else:\n",
    "                return None\n",
    "        except Exception:\n",
    "            time.sleep(2)\n",
    "    return None\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 4. Master Answering Engine\n",
    "# ---------------------------------------------------------------------------\n",
    "def answer_question(question_text, chunks):\n",
    "    \"\"\"\n",
    "    Answers drilling questions using retrieved document evidence and Gemini LLM.\n",
    "    Enforces honest uncertainty across schema boundaries and missing files.\n",
    "    \"\"\"\n",
    "    text_lower = question_text.lower()\n",
    "\n",
    "    # Step A: Missing records in archive\n",
    "    if not chunks:\n",
    "        return {\n",
    "            \"answer\": \"Information not recorded in the available daily drilling reports (no matching report exists in the archive).\",\n",
    "            \"evidence\": \"\",\n",
    "            \"confidence\": 0.0\n",
    "        }\n",
    "\n",
    "    # Step B: Schema-unsupported domains (financials, POB, supervisor)\n",
    "    for pattern, explanation in SCHEMA_UNSUPPORTED_DOMAINS:\n",
    "        if re.search(pattern, text_lower):\n",
    "            return {\n",
    "                \"answer\": f\"Information not recorded in the daily drilling reports. {explanation}\",\n",
    "                \"evidence\": \"\",\n",
    "                \"confidence\": 0.0\n",
    "            }\n",
    "\n",
    "    evidence_str = \"; \".join(f\"{c['file_name']}, Section: {c['section_name']}\" for c in chunks)\n",
    "    context_text = \"\\n\\n\".join(f\"[{c['file_name']}, Section: {c['section_name']}]\\n{c['content']}\" for c in chunks)\n",
    "\n",
    "    # Step C: Pure LLM generation via Gemini\n",
    "    llm_ans = call_gemini(question_text, context_text)\n",
    "    if llm_ans:\n",
    "        ans_lower = llm_ans.lower()\n",
    "        if any(p in ans_lower for p in [\"not recorded\", \"not mentioned\", \"not provided\", \"no record\", \"cannot be determined\"]):\n",
    "            return {\"answer\": llm_ans, \"evidence\": \"\", \"confidence\": 0.0}\n",
    "        return {\"answer\": llm_ans, \"evidence\": evidence_str, \"confidence\": 1.0}\n",
    "\n",
    "    return {\n",
    "        \"answer\": \"Unable to generate answer from evidence.\",\n",
    "        \"evidence\": evidence_str,\n",
    "        \"confidence\": 0.0\n",
    "    }\n",
    "\n",
    "status = f\"Gemini 3.5 Flash Lite Active ({'API Key Connected' if GEMINI_API_KEY else 'Missing API Key'})\"\n",
    "print(f\"[OK] Step 5 — Pure LLM Answering Engine Initialized: {status}\")\n"
