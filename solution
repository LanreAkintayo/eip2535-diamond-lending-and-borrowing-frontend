    "# Define folder paths\n",
    "dataset_folder = locate_dataset_folder()\n",
    "daily_reports_folder = dataset_folder / \"documents\" / \"daily_drilling_reports\" / \"Daily_Drilling_Report___XML_Version\"\n",
    "wellbore_folder = dataset_folder / \"documents\" / \"wellbore_files\"\n",
    "questions_file = dataset_folder / \"open_test\" / \"open_test_questions.csv\"\n",
