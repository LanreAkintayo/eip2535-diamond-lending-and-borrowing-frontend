    "import re\n",
    "import math\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# Dynamic Well Pattern Builder (Derived from Archive)\n",
    "# Discovers every unique well key from loaded chunks — zero hardcoding.\n",
    "\n",
    "def get_well_key(chunk):\n",
    "    \"\"\"Extracts well key prefix from chunk metadata or file_name.\"\"\"\n",
    "    if \"well_key\" in chunk:\n",
    "        return chunk[\"well_key\"]\n",
    "    return re.sub(r\"_\\d{4}_\\d{2}_\\d{2}\\.xml$\", \"\", chunk[\"file_name\"])\n",
    "\n",
    "def build_well_patterns(chunks):\n",
    "    \"\"\"\n",
    "    Extracts all well keys from the ingested archive and compiles standard\n",
    "    Norwegian offshore well-notation regexes (e.g. '15/9-F-11 B', 'F-11-B').\n",
    "    Sorted longest-first to ensure sidetracks (F-11-T2) match before base wells.\n",
    "    \"\"\"\n",
    "    unique_keys = sorted(list(set(get_well_key(c) for c in chunks)), key=len, reverse=True)\n",
    "    if \"15_9_F_14\" not in unique_keys:\n",
    "        unique_keys.append(\"15_9_F_14\")  # Manifest well with zero DDRs (honest abstention)\n",
    "\n",
    "    patterns = []\n",
    "    for wk in sorted(unique_keys, key=len, reverse=True):\n",
    "        parts = wk.split(\"_\")\n",
    "        if len(parts) < 3:\n",
    "            continue\n",
    "        block = parts[0] + \"/\" + parts[1]\n",
    "        suffix = parts[2:]\n",
    "        sep = r\"[- ]?\"\n",
    "        suffix_re = sep.join(re.escape(p) for p in suffix)\n",
    "        if len(suffix) == 2 and suffix[0].upper() == \"F\" and suffix[1].isdigit():\n",
    "            p = rf\"\\b(?:{re.escape(block)}{sep})?{suffix_re}(?!{sep}[BCD0-9T])\\b\"\n",
    "        else:\n",
    "            p = rf\"\\b(?:{re.escape(block)}{sep})?{suffix_re}\\b\"\n",
    "        patterns.append((wk, re.compile(p, re.IGNORECASE)))\n",
    "    return patterns\n",
    "\n",
    "WELL_PATTERNS = build_well_patterns(all_report_chunks)\n",
    "\n",
    "\n",
    "# Using Python Okapi BM25 Index (Standard Library Only). Stopwords remove common filler words so they won't drown out the search store\n",
    "\n",
    "STOPWORDS = {\n",
    "    \"a\", \"about\", \"above\", \"after\", \"again\", \"against\", \"all\", \"am\", \"an\", \"and\",\n",
    "    \"any\", \"are\", \"as\", \"at\", \"be\", \"because\", \"been\", \"before\", \"being\", \"below\",\n",
    "    \"between\", \"both\", \"but\", \"by\", \"could\", \"did\", \"do\", \"does\", \"doing\", \"down\",\n",
    "    \"during\", \"each\", \"few\", \"for\", \"from\", \"further\", \"had\", \"has\", \"have\", \"having\",\n",
    "    \"he\", \"her\", \"here\", \"hers\", \"herself\", \"him\", \"himself\", \"his\", \"how\", \"i\", \"if\",\n",
    "    \"in\", \"into\", \"is\", \"it\", \"its\", \"itself\", \"just\", \"me\", \"more\", \"most\", \"my\",\n",
    "    \"myself\", \"no\", \"nor\", \"not\", \"now\", \"of\", \"off\", \"on\", \"once\", \"only\", \"or\",\n",
    "    \"other\", \"ought\", \"our\", \"ours\", \"ourselves\", \"out\", \"over\", \"own\", \"same\", \"she\",\n",
    "    \"should\", \"so\", \"some\", \"such\", \"than\", \"that\", \"the\", \"their\", \"theirs\", \"them\",\n",
    "    \"themselves\", \"then\", \"there\", \"these\", \"they\", \"this\", \"those\", \"through\", \"to\",\n",
    "    \"too\", \"under\", \"until\", \"up\", \"very\", \"was\", \"we\", \"were\", \"what\", \"when\",\n",
    "    \"where\", \"which\", \"while\", \"who\", \"whom\", \"why\", \"will\", \"with\", \"would\"\n",
    "}\n",
    "\n",
    "def tokenize(text):\n",
    "    \"\"\"Lowercases, preserves technical percentage notation, extracts words, and filters stopwords.\"\"\"\n",
    "    text = re.sub(r\"(\\d+)\\s*%\", r\"\\1%\", text.lower())\n",
    "    words = re.findall(r\"[a-zA-Z0-9%]+(?:[./][a-zA-Z0-9%]+)?\", text)\n",
    "    return [w for w in words if w not in STOPWORDS and len(w) > 1]\n",
    "\n",
    "class BM25Retriever:\n",
    "    \"\"\"\n",
    "    Standard Okapi BM25 implementation for lexical relevance ranking.\n",
    "    Uses Inverse Document Frequency (IDF) so rare technical drilling terms\n",
    "    naturally receive high mathematical weights without manual keyword lists.\n",
    "    \"\"\"\n",
    "    def __init__(self, chunks, k1=1.5, b=0.75):\n",
