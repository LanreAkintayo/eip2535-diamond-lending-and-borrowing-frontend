    "        \n",
    "    # Case C: Multi-report single well or general query -> top distinct files\n",
    "    seen_files = set()\n",
    "    selected = []\n",
    "    max_score = scored[0][1] if scored else 0.0\n",
    "    min_thresh = max(0.5, max_score * 0.25)\n",
    "    \n",
    "    for c, s in scored:\n",
    "        if s >= min_thresh and c[\"file_name\"] not in seen_files:\n",
    "            seen_files.add(c[\"file_name\"])\n",
    "            selected.append(c)\n",
    "            if len(selected) >= 4:\n",
    "                break\n",
    "                \n",
    "    if not selected and scored:\n",
    "        for c, s in scored:\n",
    "            if c[\"file_name\"] not in seen_files:\n",
    "                seen_files.add(c[\"file_name\"])\n",
    "                selected.append(c)\n",
    "                if len(selected) >= 4:\n",
    "                    break\n",
    "\n",
    "    return selected\n",
    "\n",
    "print(f\"[OK] Step 4 — Universal Okapi BM25 Index Initialized ({len(all_report_chunks)} chunks indexed, {len(WELL_PATTERNS)} well patterns compiled).\")\n"
