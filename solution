    "import json\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "# Official WITSML XML namespace\n",
    "xml_namespace = {\"w\": \"http://www.witsml.org/schemas/1series\"}\n",
    "\n",
    "def get_clean_text(parent_element, tag_name):\n",
    "    \"\"\"\n",
    "    Finds a tag and returns its text. Returns an empty string\n",
    "    if the tag is missing or marked as '-999.99' (unrecorded in drilling standards).\n",
    "    \"\"\"\n",
    "    if parent_element is None:\n",
    "        return \"\"\n",
    "    child_node = parent_element.find(tag_name, xml_namespace)\n",
    "    if child_node is not None and child_node.text:\n",
    "        text_value = child_node.text.strip()\n",
    "        if text_value == \"-999.99\":\n",
    "            return \"\"\n",
    "        return text_value\n",
    "    return \"\"\n",
    "\n",
    "def read_daily_report(file_path):\n",
    "    \"\"\"\n",
    "    Reads a single WITSML XML daily drilling report into a clean in-memory dictionary.\n",
    "    Exhaustively extracts all operational metrics, fluids, surveys, activities, and logs.\n",
    "    \"\"\"\n",
    "    xml_path = Path(file_path)\n",
    "    root_node = ET.parse(xml_path).getroot()\n",
    "    \n",
    "    status_info = root_node.find(\".//w:statusInfo\", xml_namespace)\n",
    "    wellbore_info = root_node.find(\".//w:wellboreInfo\", xml_namespace)\n",
    "    \n",
    "    # 1. Report Identity\n",
    "    well_name = get_clean_text(root_node, \".//w:nameWell\")\n",
    "    report_date = get_clean_text(status_info, \"w:dTim\")[:10]  # Format: YYYY-MM-DD\n",
    "    report_number = get_clean_text(status_info, \"w:reportNo\") or \"1\"\n",
    "    rig_name = get_clean_text(wellbore_info, \".//w:rigAlias/w:name\")\n",
    "    spud_date = get_clean_text(wellbore_info, \"w:dTimSpud\")[:10]\n",
    "    \n",
    "    # 2. Key Operational Depths & Parameters\n",
    "    current_depth = get_clean_text(status_info, \"w:md\")\n",
    "    tvd_depth = get_clean_text(status_info, \"w:tvd\")\n",
    "    kickoff_depth = get_clean_text(status_info, \"w:mdKickoff\")\n",
    "    hole_diameter = get_clean_text(status_info, \"w:diaHole\")\n",
    "    water_depth = get_clean_text(status_info, \"w:waterDepth\")\n",
    "    summary_24h = get_clean_text(status_info, \"w:sum24Hr\")\n",
    "    forecast_24h = get_clean_text(status_info, \"w:forecast24Hr\")\n",
    "    \n",
    "    # 3. Drilling Mud and Fluids Checks\n",
    "    fluid_checks = []\n",
    "    for fluid_tag in root_node.findall(\".//w:fluid\", xml_namespace):\n",
    "        fluid_checks.append({\n",
    "            \"fluid_type\": get_clean_text(fluid_tag, \"w:type\"),\n",
    "            \"sample_location\": get_clean_text(fluid_tag, \"w:locationSample\"),\n",
    "            \"sample_time\": get_clean_text(fluid_tag, \"w:dTim\")[11:16],  # HH:MM\n",
    "            \"density\": get_clean_text(fluid_tag, \"w:density\")\n",
    "        })\n",
    "        \n",
    "    # 4. Directional Survey Stations (Inclination and Depths)\n",
    "    survey_stations = []\n",
    "    for survey_tag in root_node.findall(\".//w:surveyStation\", xml_namespace):\n",
    "        survey_stations.append({\n",
    "            \"depth_md\": get_clean_text(survey_tag, \"w:md\"),\n",
    "            \"depth_tvd\": get_clean_text(survey_tag, \"w:tvd\"),\n",
    "            \"inclination\": get_clean_text(survey_tag, \"w:incl\"),\n",
    "            \"azimuth\": get_clean_text(survey_tag, \"w:azi\")\n",
    "        })\n",
    "        \n",
    "    # 5. Timeline Activities (24 Hours)\n",
    "    activities = []\n",
    "    for activity_tag in root_node.findall(\".//w:activity\", xml_namespace):\n",
    "        activities.append({\n",
    "            \"start_time\": get_clean_text(activity_tag, \"w:dTimStart\")[11:16],\n",
    "            \"end_time\": get_clean_text(activity_tag, \"w:dTimEnd\")[11:16],\n",
    "            \"depth\": get_clean_text(activity_tag, \"w:md\"),\n",
    "            \"comment\": get_clean_text(activity_tag, \"w:comments\")\n",
    "        })\n",
    "        \n",
    "    # 6. Pore Pressures\n",
    "    pore_pressures = []\n",
    "    for pp_tag in root_node.findall(\".//w:porePressure\", xml_namespace):\n",
    "        pore_pressures.append({\n",
    "            \"depth_md\": get_clean_text(pp_tag, \"w:md\"),\n",
    "            \"equivalent_mud_weight\": get_clean_text(pp_tag, \"w:equivalentMudWeight\")\n",
    "        })\n",
    "        \n",
    "    # 7. Casing and Tubing Records\n",
    "    casing_records = []\n",
    "    for casing_tag in root_node.findall(\".//w:casing_liner_tubing\", xml_namespace):\n",
    "        casing_records.append({\n",
    "            \"outer_diameter\": get_clean_text(casing_tag, \"w:od\"),\n",
    "            \"inner_diameter\": get_clean_text(casing_tag, \"w:id\"),\n",
    "            \"grade\": get_clean_text(casing_tag, \"w:grade\")\n",
    "        })\n",
    "        \n",
    "    # 8. Equipment Failures (if logged)\n",
    "    equipment_failures = []\n",
    "    for eq_tag in root_node.findall(\".//w:equipFailureInfo\", xml_namespace):\n",
    "        equipment_failures.append({\n",
    "            \"depth\": get_clean_text(eq_tag, \"w:md\"),\n",
    "            \"description\": get_clean_text(eq_tag, \"w:description\"),\n",
    "            \"downtime_hours\": get_clean_text(eq_tag, \"w:eTimMissProduction\")\n",
    "        })\n",
    "        \n",
    "    # 9. Wireline Logging Runs (if logged)\n",
    "    wireline_logs = []\n",
    "    for log_tag in root_node.findall(\".//w:logInfo\", xml_namespace):\n",
    "        wireline_logs.append({\n",
    "            \"service_company\": get_clean_text(log_tag, \"w:serviceCompany\"),\n",
    "            \"tool\": get_clean_text(log_tag, \"w:tool\"),\n",
    "            \"run_number\": get_clean_text(log_tag, \"w:runNumber\")\n",
    "        })\n",
    "        \n",
    "    # 10. Gas Readings (if logged)\n",
    "    gas_readings = []\n",
    "    for gas_tag in root_node.findall(\".//w:gasReadingInfo\", xml_namespace):\n",
    "        gas_readings.append({\n",
    "            \"reading_type\": get_clean_text(gas_tag, \"w:readingType\"),\n",
    "            \"depth\": get_clean_text(gas_tag, \"w:mdTop\"),\n",
    "            \"gas_high\": get_clean_text(gas_tag, \"w:gasHigh\")\n",
    "        })\n",
    "        \n",
    "    # 11. Drill Bit Records (if logged)\n",
    "    bit_records = []\n",
    "    for bit_tag in root_node.findall(\".//w:bitRecord\", xml_namespace):\n",
    "        bit_records.append({\n",
    "            \"bit_number\": get_clean_text(bit_tag, \"w:numBit\"),\n",
    "            \"size_in\": get_clean_text(bit_tag, \"w:diaBit\"),\n",
    "            \"manufacturer\": get_clean_text(bit_tag, \"w:manufacturer\"),\n",
    "            \"iadc_code\": get_clean_text(bit_tag, \"w:codeIADC\"),\n",
    "            \"comment\": get_clean_text(bit_tag, \"w:comment\")\n",
    "        })\n",
    "        \n",
    "    # 12. Geological Stratigraphy / Formations (if logged)\n",
    "    stratigraphy = []\n",
    "    for strat_tag in root_node.findall(\".//w:stratInfo\", xml_namespace):\n",
    "        stratigraphy.append({\n",
    "            \"formation_name\": get_clean_text(strat_tag, \"w:name\"),\n",
    "            \"depth_md\": get_clean_text(strat_tag, \"w:mdTop\")\n",
    "        })\n",
    "        \n",
    "    # 13. Lithology Shows (if logged)\n",
    "    lithology_shows = []\n",
    "    for lith_tag in root_node.findall(\".//w:lithShowInfo\", xml_namespace):\n",
    "        lithology_shows.append({\n",
    "            \"depth_md\": get_clean_text(lith_tag, \"w:mdTop\"),\n",
    "            \"lithology\": get_clean_text(lith_tag, \"w:lithology\")\n",
    "        })\n",
    "        \n",
    "    return {\n",
    "        \"file_name\": xml_path.name,\n",
    "        \"well_name\": well_name,\n",
    "        \"report_date\": report_date,\n",
    "        \"report_number\": report_number,\n",
    "        \"rig_name\": rig_name,\n",
    "        \"spud_date\": spud_date,\n",
    "        \"current_depth_m\": current_depth,\n",
    "        \"tvd_depth_m\": tvd_depth,\n",
    "        \"kickoff_depth_m\": kickoff_depth,\n",
    "        \"hole_diameter_in\": hole_diameter,\n",
    "        \"water_depth_m\": water_depth,\n",
    "        \"summary_24h\": summary_24h,\n",
    "        \"forecast_24h\": forecast_24h,\n",
    "        \"fluid_checks\": fluid_checks,\n",
    "        \"survey_stations\": survey_stations,\n",
    "        \"activities\": activities,\n",
    "        \"pore_pressures\": pore_pressures,\n",
    "        \"casing_records\": casing_records,\n",
    "        \"equipment_failures\": equipment_failures,\n",
    "        \"wireline_logs\": wireline_logs,\n",
    "        \"gas_readings\": gas_readings,\n",
    "        \"bit_records\": bit_records,\n",
    "        \"stratigraphy\": stratigraphy,\n",
    "        \"lithology_shows\": lithology_shows\n",
    "    }\n",
    "\n",
    "# Let's test a file\n",
    "sample_file = daily_reports_folder / \"15_9_F_1_2013_08_12.xml\"\n",
    "sample_report = read_daily_report(sample_file)\n",
    "\n",
    "print(\"[OK] Sample Daily Drilling Report (Parsed In-Memory):\")\n",
    "print(json.dumps(sample_report, indent=2))\n"
   ]
