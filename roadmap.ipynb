# Step 2: Universal DDR Ingestion Engine (XML, HTML, and PDF)

def parse_ddr_xml(file_path):
    """Parses a WITSML XML Daily Drilling Report."""
    path = Path(file_path)
    ns = {'w': 'http://www.witsml.org/schemas/1series'}
    tree = ET.parse(path)
    root = tree.getroot()
    
    def get_val(elem, path_str):
        t = elem.find(path_str, ns) if elem is not None else None
        return t.text.strip() if t is not None and t.text else ""
    
    status = root.find('.//w:statusInfo', ns)
    well = get_val(root, './/w:nameWell')
    rep_no = get_val(status, 'w:reportNo') or "1"
    dt_str = get_val(status, 'w:dTim')[:10]
    rig = get_val(root, './/w:wellboreInfo/w:rigAlias/w:name')
    spud = get_val(root, './/w:wellboreInfo/w:dTimSpud')[:10]
    
    md = get_val(status, 'w:md')
    kickoff = get_val(status, 'w:mdKickoff')
    hole_dia = get_val(status, 'w:diaHole')
    sum24 = get_val(status, 'w:sum24Hr')
    forecast24 = get_val(status, 'w:forecast24Hr')
    
    # Clean sentinels
    md = md if md != "-999.99" else ""
    kickoff = kickoff if kickoff != "-999.99" else ""
    
    # Parse activities
    activities = []
    for act in root.findall('.//w:activity', ns):
        t0 = get_val(act, 'w:dTimStart')[11:16]
        t1 = get_val(act, 'w:dTimEnd')[11:16]
        comm = get_val(act, 'w:comments')
        activities.append({"start": t0, "end": t1, "comment": comm})
        
    # Parse fluids
    fluids = []
    for fl in root.findall('.//w:fluid', ns):
        ftype = get_val(fl, 'w:type')
        loc = get_val(fl, 'w:locationSample')
        time_str = get_val(fl, 'w:dTim')[11:16]
        den = get_val(fl, 'w:density')
        fluids.append({"type": ftype, "location": loc, "time": time_str, "density": den})
        
    # Parse surveys
    surveys = []
    for s in root.findall('.//w:surveyStation', ns):
        surveys.append({
            "md": get_val(s, 'w:md'),
            "tvd": get_val(s, 'w:tvd'),
            "incl": get_val(s, 'w:incl'),
            "azi": get_val(s, 'w:azi')
        })
        
    # Parse pore pressures
    pore_pressures = []
    for pp in root.findall('.//w:porePressure', ns):
        pore_pressures.append({
            "md": get_val(pp, 'w:md'),
            "emw": get_val(pp, 'w:equivalentMudWeight')
        })
        
    # Parse casings
    casings = []
    for csg in root.findall('.//w:casing_liner_tubing', ns):
        casings.append({
            "od": get_val(csg, 'w:od'),
            "id": get_val(csg, 'w:id'),
            "grade": get_val(csg, 'w:grade'),
            "conn": get_val(csg, 'w:connection')
        })
        
    return {
        "file_name": path.name,
        "format": "xml",
        "well": well,
        "date": dt_str,
        "report_no": rep_no,
        "rig": rig,
        "spud_date": spud,
        "current_md": md,
        "kickoff_md": kickoff,
        "hole_dia": hole_dia,
        "summary_24h": sum24,
        "forecast_24h": forecast24,
        "activities": activities,
        "fluids": fluids,
        "surveys": surveys,
        "pore_pressures": pore_pressures,
        "casings": casings
    }

def parse_ddr_html(file_path):
    """Parses a Daily Drilling Report HTML export."""
    path = Path(file_path)
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        soup = BeautifulSoup(f.read(), "html.parser")
        
    well = ""
    dt_str = ""
    for b in soup.find_all("b"):
        if "Wellbore:" in b.text and b.parent:
            well = b.parent.text.replace("Wellbore:", "").strip()
        if "Period:" in b.text and b.parent:
            p_text = b.parent.text.replace("Period:", "").strip()
            m = re.search(r"(\d{4}-\d{2}-\d{2})", p_text)
            if m:
                dt_str = m.group(1)
                
    table_dict = {}
    for tr in soup.find_all("tr"):
        tds = tr.find_all("td")
        if len(tds) >= 2:
            k = tds[0].text.strip().rstrip(":")
            v = tds[1].text.strip()
            if v != "-999.99":
                table_dict[k] = v
                
    texts = [p.text.strip() for p in soup.find_all("p", class_="TextData")]
    sum24 = texts[0] if len(texts) > 0 else ""
    forecast24 = texts[1] if len(texts) > 1 else ""
    
    surveys = []
    s_tbl = soup.find("table", attrs={"info": "surveystationInfoTable"})
    if s_tbl:
        for tr in s_tbl.find_all("tr")[1:]:
            cols = [td.text.strip() for td in tr.find_all("td")]
            if len(cols) >= 4:
                surveys.append({"md": cols[0], "tvd": cols[1], "incl": cols[2], "azi": cols[3]})
                
    return {
        "file_name": path.name,
        "format": "html",
        "well": well,
        "date": dt_str,
        "report_no": table_dict.get("Report number", "1"),
        "rig": table_dict.get("Rig Name", ""),
        "spud_date": table_dict.get("Spud Date", "")[:10],
        "current_md": table_dict.get("Depth mMd", ""),
        "kickoff_md": table_dict.get("Depth at Kick Off mMD", ""),
        "hole_dia": table_dict.get("Hole Dia ()", ""),
        "summary_24h": sum24,
        "forecast_24h": forecast24,
        "activities": [],
        "fluids": [],
        "surveys": surveys,
        "pore_pressures": [],
        "casings": []
    }

def parse_ddr_pdf(file_path):
    """Parses a Daily Drilling Report PDF file."""
    path = Path(file_path)
    text = ""
    with pdfplumber.open(path) as pdf:
        for page in pdf.pages:
            text += (page.extract_text() or "") + "\n"
            
    # Remove duplicate font glyphs (e.g. WWeellll -> Well)
    clean_text = re.sub(r'([A-Za-z])\1', r'\1', text)
    
    well_m = re.search(r'Wellbore:\s*([^\s\n]+(?:\s+[^\s\n]+)?)', clean_text, re.IGNORECASE)
    well = well_m.group(1).strip() if well_m else ""
    
    date_m = re.search(r'Period:\s*\d{4}-\d{2}-\d{2}\s*00:00\s*-\s*(\d{4}-\d{2}-\d{2})', clean_text, re.IGNORECASE)
    dt_str = date_m.group(1) if date_m else ""
    
    ko_m = re.search(r'Kick\s*Off\s*mMD:\s*([0-9\.]+)', clean_text, re.IGNORECASE)
    kickoff = ko_m.group(1) if ko_m else ""
    
    return {
        "file_name": path.name,
        "format": "pdf",
        "well": well,
        "date": dt_str,
        "report_no": "1",
        "rig": "",
        "spud_date": "",
        "current_md": "",
        "kickoff_md": kickoff,
        "hole_dia": "",
        "summary_24h": "",
        "forecast_24h": "",
        "activities": [],
        "fluids": [],
        "surveys": [],
        "pore_pressures": [],
        "casings": []
    }

def parse_ddr(file_path):
    """Unified Entrypoint: auto-detects file extension and calls matching parser."""
    ext = Path(file_path).suffix.lower()
    if ext == ".xml":
        return parse_ddr_xml(file_path)
    elif ext in {".html", ".htm"}:
        return parse_ddr_html(file_path)
    elif ext == ".pdf":
        return parse_ddr_pdf(file_path)
    else:
        raise ValueError(f"Unsupported format: {ext}")

print("Universal DDR Parsers defined successfully.")
